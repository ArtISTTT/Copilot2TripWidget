{
    "name": "copilot2trip-widget",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "compile:images": "node compileImages.cjs",
        "compile:styles": "node compileStyles.cjs",
        "complie:all": "npm run compile:images && npm run compile:styles",
        "dev": "npm run complie:all && vite",
        "build": "npm run complie:all && tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^1.9.6",
        "classnames": "^2.3.2",
        "formik": "^2.4.5",
        "less": "^4.2.0",
        "less-plugin-glob": "^3.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-redux": "^8.1.2",
        "react-svg": "^16.1.26",
        "redux": "^4.2.1",
        "yup": "^1.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.7.0",
        "@types/react": "^18.2.15",
        "@types/react-dom": "^18.2.7",
        "@typescript-eslint/eslint-plugin": "6.7.3",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitejs/plugin-react": "^4.0.3",
        "eslint": "^8.45.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-react": "^7.31.11",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.3",
        "eslint-plugin-unused-imports": "^3.0.0",
        "prettier": "^3.0.3",
        "prettier-plugin-organize-imports": "^3.2.3",
        "sharp": "^0.32.6",
        "typescript": "^5.0.2",
        "vite": "^4.4.5"
    }
}
